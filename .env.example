# Local-only: HOST=127.0.0.1
# Phone/LAN testing or containers: HOST=0.0.0.0
HOST=127.0.0.1
PORT=8080

# Optional exact override. Leave empty unless needed.
ADDR=

# Demo admin password for local development only.
# Production validation rejects this default when PRODUCTION=true or APP_ENV=production.
ADMIN_PASSWORD=change-me

# Local runtime storage. The app creates these files/directories automatically.
DATA_FILE=data/results.json
DATABASE_PATH=data/app.db

# Keep false locally. Use true only behind HTTPS.
COOKIE_SECURE=false

# Set PRODUCTION=true or APP_ENV=production for deployment validation.
PRODUCTION=false
APP_ENV=development

# Comma-separated CIDRs whose X-Forwarded-For headers may be trusted.
TRUSTED_PROXY_CIDRS=
